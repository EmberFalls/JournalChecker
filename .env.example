# Local service configuration. Copy this to .env; never commit real credentials.
DATABASE_URL=postgresql+psycopg://journal:journal@postgres:5432/journal_integrity
REDIS_URL=redis://redis:6379/0
APP_ENV=development
CROSSREF_MAILTO=contact@example.com
CROSSREF_USER_AGENT=journal-integrity-mvp/0.1 (mailto:contact@example.com)
SCOPUS_API_KEY=
SCOPUS_SOURCE_LIST_PATH=
DOAJ_DATASET_PATH=
CRAWL_MAX_PAGES=8
CRAWL_MAX_DEPTH=2
CRAWL_TIMEOUT_SECONDS=8
CRAWL_MAX_RESPONSE_BYTES=1500000
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
